{
  "openapi": "3.1.0",
  "info": {
    "title": "Pediatric Bone Age Engine API",
    "description": "Demonstration-only generic rule engine plus manually entered skeletal-age comparison; no radiograph analysis or clinically validated interpretation.",
    "version": "2.0.0",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "System optimal"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Return JSON counts for demonstration requests",
        "responses": {
          "200": {
            "description": "JSON counters"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Dispatch task payload across specialized workers",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consensus dossier with HMAC signature"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Query deterministic demonstration adapter",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Retrieve and cryptographically verify HMAC audit trail",
        "responses": {
          "200": {
            "description": "Cryptographic audit trail"
          }
        }
      }
    },
    "/api/bone-age/compare": {
      "post": {
        "summary": "Compare manually entered skeletal age and chronological age (months)",
        "description": "Descriptive arithmetic only. The skeletal age is entered after independent assessment; no GP/TW scoring or clinical thresholds.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "chronological_age_months": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 240
                  },
                  "bone_age_months": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 240
                  },
                  "assessment_method": {
                    "type": "string",
                    "enum": [
                      "Unspecified",
                      "Greulich-Pyle",
                      "Tanner-Whitehouse",
                      "Other"
                    ],
                    "default": "Unspecified"
                  }
                },
                "required": [
                  "chronological_age_months",
                  "bone_age_months"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed difference and direction"
          },
          "422": {
            "description": "Invalid input"
          }
        }
      }
    }
  }
}
